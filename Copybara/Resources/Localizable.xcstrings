    "Your clipboard history, one keystroke away.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your clipboard history, one keystroke away."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся история буфера — по одному сочетанию клавиш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Zwischenablageverlauf, nur ein Tastenkürzel entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique du presse-papiers à portée de raccourci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu historial del portapapeles, a un atajo de distancia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia degli appunti, a una scorciatoia di distanza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico da área de transferência, a um atalho de distância."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下快捷键，即可查看剪贴板历史。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットひとつでクリップボード履歴を表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 하나로 클립보드 기록을 확인하세요."
          }
        }
      }
    }
