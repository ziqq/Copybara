    "To paste into the app you were using, Copybara needs Accessibility access. It never reads your screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To paste into the app you were using, Copybara needs Accessibility access. It never reads your screen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вставки в приложение Copybara нужен универсальный доступ. Содержимое экрана не считывается."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Einfügen in die zuvor verwendete App benötigt Copybara Zugriff auf Bedienungshilfen. Ihr Bildschirm wird niemals ausgelesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour coller dans l’app que vous utilisiez, Copybara a besoin de l’autorisation d’accessibilité. Il ne lit jamais votre écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pegar en la app que estabas usando, Copybara necesita acceso de accesibilidad. Nunca lee tu pantalla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per incollare nell’app che stavi usando, Copybara richiede l’accesso all’accessibilità. Non legge mai lo schermo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para colar na app que estava a utilizar, o Copybara precisa de acesso à acessibilidade. Nunca lê o seu ecrã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copybara 需要辅助功能权限，才能将内容粘贴到你使用的应用中。它不会读取屏幕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用していたアプリに貼り付けるには、アクセシビリティの許可が必要です。画面の内容を読み取ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중이던 앱에 붙여넣으려면 Copybara에 손쉬운 사용 권한이 필요합니다. 화면 내용은 읽지 않습니다."
          }
        }
      }
    },
