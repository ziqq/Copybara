            "value": "Aucune app bloquée. Les copies des apps bloquées ne sont jamais enregistrées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay apps bloqueadas. Las copias de apps bloqueadas nunca se guardan."
