    "No blocked apps. Copies from blocked apps are never recorded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No blocked apps. Copies from blocked apps are never recorded."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет исключённых приложений. Копирования из исключённых приложений не записываются."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine blockierten Apps. Kopien aus blockierten Apps werden nie gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
